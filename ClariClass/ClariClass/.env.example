# ClariClass Environment Configuration Template

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL or SQLite for local dev)
DATABASE_URL=sqlite:///./clariclass.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clariclass

# Auth & OTP Security
JWT_SECRET_KEY=replace-this-with-a-secure-random-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
OTP_EXPIRE_SECONDS=300
OTP_DEV_BYPASS=false
# Optional SMS/Email Gateway credentials for OTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# AI Model Configuration (Gemma 4 / Google Gemini API)
GEMINI_API_KEY=your_gemini_or_gemma_api_key_here
GEMMA_MODEL_NAME=gemma-4-it
GEMMA_TEMPERATURE=0.2

# Classroom Adaptive Engine Thresholds
DEFAULT_STRUGGLE_THRESHOLD_PERCENT=25.0
DEFAULT_MIN_STUDENTS_FOR_THRESHOLD=3
DWELL_TIME_STRUGGLE_THRESHOLD_MS=45000
RE_READ_STRUGGLE_THRESHOLD_COUNT=3
